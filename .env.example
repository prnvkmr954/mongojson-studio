# Application configuration. Use a dedicated database for app accounts, not a customer's Atlas URI.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_TTL_MINUTES=30
MAX_UPLOAD_MB=10
# Required: dedicated persistent MongoDB database for users and auth sessions.
AUTH_MONGODB_URI=mongodb+srv://<app-user>:<password>@<auth-cluster>/<database>?retryWrites=true&w=majority
AUTH_DATABASE=mongojson_studio_auth
AUTH_SESSION_TTL_HOURS=24
NODE_ENV=development

# Optional Google OAuth. Configure these values in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
